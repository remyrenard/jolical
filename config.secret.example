# Jolical : identifiants (copier ce fichier en config.secret, puis : sudo chown 1000:1000 config.secret ; chmod 600 config.secret)
# Une ligne NOM=valeur par variable, sans guillemets. Les lignes qui commencent par # sont ignorées.

# Nextcloud : adresse, utilisateur (idéalement un compte dédié) et mot de passe d'application de cet utilisateur
NC_URL=https://cloud.example.com
NC_USER=jolical
NC_APP_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx

# Mot de passe de Jolical : empreinte générée par « docker compose run --rm jolical node hash.js »
APP_PASSWORD_HASH=scrypt:16384:8:1:remplacer:par-la-ligne-generee
